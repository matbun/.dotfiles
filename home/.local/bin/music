#!/bin/bash
# music: stop the background recording started by "call" and switch
# Bluetooth headphones back to music mode (A2DP, no mic).
pidfile=${XDG_RUNTIME_DIR:-/tmp}/btcall.pid
pid=$(cat "$pidfile" 2>/dev/null)
if [ -n "$pid" ] && [ "$(ps -o comm= -p "$pid")" = pacat ]; then
    kill "$pid"
fi
rm -f "$pidfile"

card=$(pactl list cards short | awk '$2 ~ /^bluez_card/ {print $2; exit}')
if [ -z "$card" ]; then
    echo "music: no Bluetooth headphones connected" >&2
    exit 1
fi
pactl set-card-profile "$card" a2dp-sink && echo "music mode: full sound quality, mic off"
